---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { rankingTopics } from '../../data/topics';

const title = '机场排行榜大全 · 2026综合实力与性价比排行 - vpnjichang.wiki';
const description = '多维度客观机场排行榜单。包含年度综合实力榜、每GB单价性价比榜、10元以内平价低预算榜及晚高峰0丢包高稳定性专线榜。';
const keywords = '机场排行榜, 翻墙梯子排名, 综合实力机场, 性价比机场, 稳定机场推荐, vpn推荐';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '机场排行榜' }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "机场排行榜大全",
  "description": description,
  "itemListElement": rankingTopics.map((t, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": t.h1,
    "url": `https://vpnjichang.wiki/ranking/${t.slug}.html`
  }))
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  activeNav="ranking"
  breadcrumbs={breadcrumbs}
  schemaJson={schema}
>
  <main class="container" style="padding-bottom: 60px;">
    <div class="section-header" style="margin-top: 20px;">
      <span class="section-tag">Rankings & Awards</span>
      <h1 class="section-title">2026 年度多维度机场客观实力排行榜</h1>
      <p class="section-desc">
        我们通过持续的晚高峰自动化测速探针、流媒体全区解锁验证与长期在线监测，从不同维度呈现各品牌真实的技术与服务水准。
      </p>
    </div>
    <div class="cards-grid">
      {rankingTopics.map(t => (
        <div class="airport-card">
          <div class="card-header">
            <h3 class="airport-brand-name"><a href={`/ranking/${t.slug}.html`}>{t.h1}</a></h3>
            <span class="airport-badge badge-stable">{t.tag}</span>
          </div>
          <p class="card-desc" style="margin-top: 8px;">{t.summary}</p>
          <div style="margin-top:auto; font-size:0.88rem;">
            <a href={`/ranking/${t.slug}.html`} class="btn-card-review">查阅完整排名榜单 &rarr;</a>
          </div>
        </div>
      ))}
    </div>
  </main>
</BaseLayout>
