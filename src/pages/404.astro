---
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '404 - 页面未找到' }
];

const title = "404 - 页面未找到 · vpnjichang.wiki";
const description = "您所请求的页面可能已被移动、更名或暂时下线。请返回首页或使用导航栏查阅最新机场推荐。";
---

<BaseLayout title={title} description={description} canonical="/404.html" breadcrumbs={breadcrumbs}>
  <div class="article-container full-width">
    <article class="article-main">
      <header class="article-header">
        <h1 class="section-title" style="font-size: 2rem; margin-bottom: 8px;">404 - 抱歉，您访问的页面不存在</h1>
        <div class="article-meta">
          <span>最后修订: 2026-03-15</span>
          <span>来源: vpnjichang.wiki 编辑部</span>
        </div>
      </header>
      <div class="article-content">
        <div style="text-align: center; padding: 40px 0;">
          <div style="font-size: 4rem; font-weight: 900; color: #2563eb; margin-bottom: 10px;">404</div>
          <p style="font-size: 1.1rem; color: #64748b; margin-bottom: 24px;">页面可能已更名、被删除或 URL 地址拼写有误。</p>
          <div style="display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;">
            <a href="/" class="btn-primary">返回网站首页</a>
            <a href="/recommend/" class="btn-secondary">查看精选机场推荐</a>
            <a href="/compare.html" class="btn-secondary">打开横向对比工具</a>
          </div>
        </div>
      </div>
    </article>
  </div>
</BaseLayout>
