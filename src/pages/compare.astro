---
import BaseLayout from '../layouts/BaseLayout.astro';
import { airportsData } from '../data/airports';

const title = '机场横向对比工具 · 2-4家机场价格流量协议全维度对比 - vpnjichang.wiki';
const description = '在线机场参数横向对比工具。自由勾选 2 到 4 家机场服务商，实时对比官方套餐价格、每GB流量单价、IPLC专线、节点覆盖地区及 ChatGPT/流媒体解锁支持。';
const keywords = '机场对比, 机场横向比较, 翻墙梯子对比, 节点价格对比, 机场推荐, vpn推荐';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '机场横向对比工具' }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "vpnjichang.wiki 机场横向对比工具",
  "url": "https://vpnjichang.wiki/compare.html",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All"
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  activeNav="compare"
  breadcrumbs={breadcrumbs}
  schemaJson={schema}
>
  <main class="container" style="padding-bottom: 60px;">
    <div class="section-header" style="margin-top: 20px;">
      <span class="section-tag">Comparison Engine</span>
      <h1 class="section-title">机场全维度多维度横向对比工具</h1>
      <p class="section-desc">
        在多家意向机场之间犹豫不决？在下方选择 2 至 4 家品牌，即可实时并排比较起步价格、每 GB 真实单价、物理专线架构与流媒体解锁能力。
      </p>
    </div>

    <!-- 交互选择器卡片 -->
    <div class="compare-selector-card">
      <div class="compare-selector-header">
        <div class="compare-selector-title-wrap">
          <div class="compare-selector-left">
            <span class="compare-selector-icon">⚖️</span>
            <span class="compare-selector-heading">对比候选品牌选择器</span>
          </div>
          <div class="compare-counter-pill">
            已选对比品牌：<strong id="selected-count">2</strong> / 4 家
          </div>
        </div>
        <div class="compare-selector-hint">
          💡 点击下方品牌药丸标签可快速添加或移出对比（<strong>至少保留 2 家，最多同时对比 4 家</strong>）：
        </div>
      </div>
      <div id="brand-selector" class="compare-tags-wrapper">
        {airportsData.map((ap, idx) => {
          const isDefaultSelected = idx < 2;
          return (
            <button
              class={`brand-pill-btn ${isDefaultSelected ? 'active' : ''}`}
              data-id={ap.id}
              type="button"
              title={`点击${isDefaultSelected ? '取消对比' : '加入对比'} ${ap.name}`}
            >
              <span class="pill-check">{isDefaultSelected ? '✓' : '+'}</span>
              <span class="pill-name">{ap.name}</span>
            </button>
          );
        })}
      </div>
    </div>

    <!-- 动态对比表格容器 -->
    <div style="overflow-x: auto; background: #ffffff; border: 1px solid var(--border-color); border-radius: 14px; box-shadow: var(--shadow-sm); margin-bottom: 30px;">
      <table class="ranking-table" id="compare-table" style="min-width: 820px; width: 100%; border-collapse: collapse;">
        <thead id="compare-thead">
          <!-- 动态表头 -->
        </thead>
        <tbody id="compare-tbody">
          <!-- 动态数据行 -->
        </tbody>
      </table>
    </div>

    <div id="compare-empty" style="display: none; padding: 40px; text-align: center; color: var(--text-muted); background: var(--bg-alt); border-radius: 12px; border: 1px dashed var(--border-color);">
      请在上方至少选择 2 家品牌进行对比分析。
    </div>
  </main>
</BaseLayout>

<script is:inline define:vars={{ airportsData }}>
  // 客户端横向对比脚本
  let selectedIds = [airportsData[0].id, airportsData[1].id];

  function updatePills() {
    const buttons = document.querySelectorAll('.brand-pill-btn');
    buttons.forEach(btn => {
      const id = btn.getAttribute('data-id');
      const isSelected = selectedIds.includes(id);
      const checkSpan = btn.querySelector('.pill-check');
      if (isSelected) {
        btn.classList.add('active');
        if (checkSpan) checkSpan.textContent = '✓';
      } else {
        btn.classList.remove('active');
        if (checkSpan) checkSpan.textContent = '+';
      }
    });
  }

  function renderTable() {
    const thead = document.getElementById('compare-thead');
    const tbody = document.getElementById('compare-tbody');
    const emptyNotice = document.getElementById('compare-empty');
    const table = document.getElementById('compare-table');
    const countSpan = document.getElementById('selected-count');

    countSpan.innerText = selectedIds.length;

    if (selectedIds.length < 2) {
      table.style.display = 'none';
      emptyNotice.style.display = 'block';
      return;
    }

    table.style.display = 'table';
    emptyNotice.style.display = 'none';

    const selectedAirports = airportsData.filter(a => selectedIds.includes(a.id));

    // 渲染表头
    thead.innerHTML = `
      <tr>
        <th style="width: 140px; background: #f8fafc; font-weight: 700;">比较维度</th>
        ${selectedAirports.map(a => `
          <th style="text-align: center; background: #f0f7ff; border-top: 3px solid #2563eb; padding: 16px 12px;">
            <div style="font-size: 1.15rem; font-weight: 800; color: #1e3a8a;">${a.name}</div>
            <div style="font-size: 0.82rem; color: #475569; font-weight: 500; margin-top: 4px; line-height: 1.4;">${a.tagline}</div>
          </th>
        `).join('')}
      </tr>
    `;

    // 比较维度行配置
    const dimensions = [
      { label: '起步价格', fn: a => `<strong style="color: #2563eb; font-size: 1.15rem; font-family: var(--font-mono);">￥${a.startingPrice.toFixed(2)}/月</strong>` },
      { label: '基础配额', fn: a => `<strong style="font-family: var(--font-mono); font-size: 1.02rem;">${a.plans[0].trafficGB} GB</strong>` },
      { label: '每GB折算单价', fn: a => `<span style="font-family: var(--font-mono); color: #334155; font-weight: 600;">约 ￥${a.plans[0].pricePerGB.toFixed(3)}/GB</span>` },
      { label: '线路架构', fn: a => a.tags.includes('premium') ? '<span class="badge" style="background: #ecfdf5; color: #047857; font-weight: 700; border: 1px solid #a7f3d0; padding: 4px 10px; border-radius: 6px;">IPLC/IEPL 国际纯专线</span>' : '<span class="badge" style="background: #f1f5f9; color: #334155; font-weight: 600; padding: 4px 10px; border-radius: 6px;">多线 BGP 智能中转</span>' },
      { label: '支持协议', fn: a => `<span style="font-family: var(--font-mono); font-size: 0.88rem; font-weight: 600; color: #475569;">${a.protocols.join(', ')}</span>` },
      { label: '覆盖枢纽', fn: a => a.regions.join('、') },
      { label: '设备限制', fn: a => `<span style="font-weight: 600; color: #334155;">${a.deviceLimit || '4-6台设备'}</span>` },
      { label: 'AI 大模型', fn: a => (a.aiSupport || []).join('、') },
      { label: '4K 流媒体', fn: a => (a.streamingSupport || []).join('、') },
      { label: '核心优势', fn: a => `<ul style="text-align:left; margin:0 0 0 16px; padding:0; font-size:0.86rem; line-height: 1.6; color: #1e293b;">${a.advantages.slice(0, 3).map(adv => `<li>${adv}</li>`).join('')}</ul>` },
      { label: '注意事项', fn: a => `<ul style="text-align:left; margin:0 0 0 16px; padding:0; font-size:0.86rem; line-height: 1.6; color: #b45309;">${a.disadvantages.map(dis => `<li>${dis}</li>`).join('')}</ul>` },
      { label: '直达入口', fn: a => `
        <div style="display:flex; gap:8px; justify-content:center; flex-wrap:wrap; margin: 4px 0;">
          <a href="review/${a.slug}.html" class="btn-card-review" style="padding:6px 14px; font-size:0.84rem; white-space:nowrap;">查看深度评测</a>
          <a href="${a.affiliateUrl || a.officialUrl}" target="_blank" rel="noopener nofollow sponsored" class="btn-card-buy" style="padding:6px 14px; font-size:0.84rem; white-space:nowrap;">前往官网直达 &rarr;</a>
        </div>
      `}
    ];

    tbody.innerHTML = dimensions.map(d => `
      <tr>
        <td style="white-space: nowrap; font-weight: 700; background: #f8fafc; color: #1e293b;">${d.label}</td>
        ${selectedAirports.map(a => `<td style="text-align: center; vertical-align: middle; padding: 14px 16px;">${d.fn(a)}</td>`).join('')}
      </tr>
    `).join('');
  }

  // 绑定按钮事件
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.brand-pill-btn');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        if (selectedIds.includes(id)) {
          if (selectedIds.length > 2) {
            selectedIds = selectedIds.filter(item => item !== id);
          } else {
            alert('至少需要保留 2 家品牌进行对比！');
            return;
          }
        } else {
          if (selectedIds.length < 4) {
            selectedIds.push(id);
          } else {
            alert('最多支持同时对比 4 家品牌！请先取消已勾选的其他品牌。');
            return;
          }
        }
        updatePills();
        renderTable();
      });
    });

    updatePills();
    renderTable();
  });
</script>
