---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { recommendTopics } from '../../data/topics';

const title = '精选机场节点推荐专题 · 专线与流媒体解锁节点汇总 - vpnjichang.wiki';
const description = '根据使用场景分类为您推荐最适合的网络代理。包含平价低预算、IPLC高端内网专线、新手一键导入、长期防失联及 ChatGPT/Netflix 解锁专题。';
const keywords = '机场推荐, 机场节点, 梯子推荐, vpn推荐, vpn机场, 性价比机场, 稳定机场';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '机场推荐专题' }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "精选机场节点推荐专题",
  "description": description,
  "itemListElement": recommendTopics.map((t, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": t.h1,
    "url": `https://vpnjichang.wiki/recommend/${t.slug}.html`
  }))
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  activeNav="recommend"
  breadcrumbs={breadcrumbs}
  schemaJson={schema}
>
  <main class="container" style="padding-bottom: 60px;">
    <div class="section-header" style="margin-top: 20px;">
      <span class="section-tag">Scenario Recommendations</span>
      <h1 class="section-title">2026 精选优质机场节点与高速网络代理推荐</h1>
      <p class="section-desc">
        不同用户对网络的需求千差万别。我们从预算、稳定性、流媒体解锁与 AI 开发等核心维度，为您量身定制分类精选专题。
      </p>
    </div>
    <div class="cards-grid">
      {recommendTopics.map(t => (
        <div class="airport-card">
          <div class="card-header">
            <h3 class="airport-brand-name"><a href={`/recommend/${t.slug}.html`}>{t.h1}</a></h3>
            <span class="airport-badge badge-stable">{t.tag}</span>
          </div>
          <p class="card-desc" style="margin-top: 8px;">{t.summary}</p>
          <div style="margin-top:auto; font-size:0.88rem;">
            <a href={`/recommend/${t.slug}.html`} class="btn-card-review">进入专题查看推荐品牌 &rarr;</a>
          </div>
        </div>
      ))}
    </div>
  </main>
</BaseLayout>
