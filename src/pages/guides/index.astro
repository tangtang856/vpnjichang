---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const guides = await getCollection('guides');

const title = '科学上网客户端使用教程中心 · Windows/Android/iOS/Mac配置指南 - vpnjichang.wiki';
const description = '涵盖全平台科学上网客户端保姆级图文教程。收录 Clash Verge、v2rayN、Clash Meta for Android、Shadowrocket 小火箭、Quantumult X、Sing-box 及软路由配置全景。';
const platforms = ['全部', 'Windows', 'Android', 'iOS', 'macOS', 'Linux / 软路由', '协议进阶', '网络调优'];

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '使用教程' }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "vpnjichang.wiki 客户端配置教程中心",
  "description": description,
  "url": "https://vpnjichang.wiki/guides/index.html",
  "itemListElement": guides.map((g, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": g.data.h1,
    "url": `https://vpnjichang.wiki/guides/${g.data.slug}.html`
  }))
};

function getCategory(platform: string) {
  if (['Windows'].includes(platform)) return 'Windows';
  if (['Android'].includes(platform)) return 'Android';
  if (['iOS'].includes(platform)) return 'iOS';
  if (['macOS'].includes(platform)) return 'macOS';
  if (['Linux', '路由器'].includes(platform)) return 'Linux / 软路由';
  if (['协议配置', '安全测试'].includes(platform)) return '协议进阶';
  return '网络调优';
}
---

<BaseLayout
  title={title}
  description={description}
  activeNav="guides"
  breadcrumbs={breadcrumbs}
  schemaJson={schema}
>
  <main class="container" style="padding-bottom: 60px;">
    <div class="section-header" style="margin-top: 20px;">
      <span class="section-tag">Setup & Guides</span>
      <h1 class="section-title">全平台科学上网客户端使用与配置教程中心</h1>
      <p class="section-desc">
        无论您使用的是 Windows PC、安卓手机、苹果 iPhone、Mac 电脑还是家庭软路由，这里都提供详尽的保姆级图文实操指南，手把手带您完成订阅导入与规则分流。
      </p>
    </div>

    <!-- 平台快速分类筛选 -->
    <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; padding: 12px; background: var(--bg-alt); border-radius: 8px; border: 1px solid var(--border-color);">
      <span style="font-size: 0.88rem; font-weight: 600; align-self: center; margin-right: 8px; color: var(--text-color);">平台筛选:</span>
      {platforms.map(p => (
        <button
          class={`filter-btn ${p === '全部' ? 'active' : ''}`}
          data-platform-target={p}
          style={`padding: 4px 12px; font-size: 0.82rem; border-radius: 20px; border: 1px solid var(--border-color); background: ${p === '全部' ? 'var(--primary-color)' : '#fff'}; color: ${p === '全部' ? '#fff' : 'var(--text-color)'}; cursor: pointer; transition: all 0.2s;`}
        >
          {p}
        </button>
      ))}
    </div>

    <div class="cards-grid" id="guides-grid">
      {guides.map((g, idx) => {
        const cat = getCategory(g.data.platform);
        return (
          <div class="airport-card guide-card-item" data-category={cat}>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 8px;">
              <span class="badge" style="background:#e0e7ff; color:#3730a3; font-weight:600; font-size:0.75rem; padding: 2px 8px; border-radius: 4px;">{g.data.platform}</span>
              <span style="font-size: 0.75rem; color: var(--text-muted);">指南 #{idx + 1}</span>
            </div>
            <h3 class="airport-brand-name" style="font-size: 1.15rem; margin-bottom: 8px;">
              <a href={`/guides/${g.data.slug}.html`}>{g.data.h1}</a>
            </h3>
            <p class="card-desc" style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 16px;">
              {g.data.summary}
            </p>
            <div style="margin-top:auto; font-size:0.88rem;">
              <a href={`/guides/${g.data.slug}.html`} class="btn-card-review">阅读完整配置指南 &rarr;</a>
            </div>
          </div>
        );
      })}
    </div>
  </main>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.guide-card-item');

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-platform-target');
        btns.forEach(b => {
          if (b === btn) {
            b.style.background = 'var(--primary-color)';
            b.style.color = '#fff';
          } else {
            b.style.background = '#fff';
            b.style.color = 'var(--text-color)';
          }
        });

        cards.forEach(c => {
          if (p === '全部' || c.getAttribute('data-category') === p) {
            c.style.display = 'flex';
          } else {
            c.style.display = 'none';
          }
        });
      });
    });
  });
</script>
