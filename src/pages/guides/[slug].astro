---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import PaginationNav from '../../components/PaginationNav.astro';
import RelatedArticles, { type RelatedItem } from '../../components/RelatedArticles.astro';
import SiteInternalLinks from '../../components/SiteInternalLinks.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  // 按平台与 slug 排序，确保顺序稳定一致
  const sortedGuides = guides.sort((a, b) => a.data.platform.localeCompare(b.data.platform) || a.data.slug.localeCompare(b.data.slug));

  return sortedGuides.map((entry, index) => {
    const prev = index > 0 ? sortedGuides[index - 1] : null;
    const next = index < sortedGuides.length - 1 ? sortedGuides[index + 1] : null;

    // 智能筛选 3 篇相关教程
    let related = sortedGuides
      .filter(g => g.data.slug !== entry.data.slug && g.data.platform === entry.data.platform)
      .slice(0, 3);

    if (related.length < 3) {
      const others = sortedGuides.filter(g => g.data.slug !== entry.data.slug && !related.some(r => r.data.slug === g.data.slug));
      related = related.concat(others.slice(0, 3 - related.length));
    }

    const prevRef = prev ? {
      title: prev.data.h1.split(' · ')[0].split('：')[0] || prev.data.title,
      url: `/guides/${prev.data.slug}.html`,
      category: prev.data.platform
    } : null;

    const nextRef = next ? {
      title: next.data.h1.split(' · ')[0].split('：')[0] || next.data.title,
      url: `/guides/${next.data.slug}.html`,
      category: next.data.platform
    } : null;

    const relatedItems: RelatedItem[] = related.map(r => ({
      title: r.data.h1,
      url: `/guides/${r.data.slug}.html`,
      category: r.data.platform,
      date: '实测推荐',
      summary: r.data.summary
    }));

    return {
      params: { slug: entry.data.slug },
      props: {
        entry,
        prevRef,
        nextRef,
        relatedItems
      }
    };
  });
}

const { entry, prevRef, nextRef, relatedItems } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '使用教程', url: '/guides/index.html' },
  { name: data.h1.split(' · ')[0].split('：')[0] }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": data.h1,
  "description": data.desc,
  "inLanguage": "zh-CN",
  "mainEntityOfPage": `https://vpnjichang.wiki/guides/${data.slug}.html`,
  "datePublished": "2026-03-01",
  "dateModified": "2026-03-15",
  "author": {
    "@type": "Organization",
    "name": "vpnjichang.wiki 客户端技术组",
    "url": "https://vpnjichang.wiki"
  },
  "publisher": {
    "@type": "Organization",
    "name": "vpnjichang.wiki",
    "logo": {
      "@type": "ImageObject",
      "url": "https://vpnjichang.wiki/images/logo.png"
    }
  }
};
---

<BaseLayout
  title={data.title}
  description={data.desc}
  activeNav="guides"
  breadcrumbs={breadcrumbs}
  schemaJson={schema}
>
  <main class="container">
    <div class="article-container">
      <article class="article-main">
        <header class="article-header">
          <div style="display:flex; gap: 8px; align-items:center; margin-bottom: 8px;">
            <span class="badge" style="background:#e0e7ff; color:#3730a3; font-weight:600; font-size:0.8rem; padding: 3px 10px; border-radius: 4px;">{data.platform}</span>
            <span style="font-size: 0.85rem; color: var(--text-muted);">更新日期: 2026-03-15</span>
          </div>
          <h1 class="section-title" style="font-size: 2.1rem; margin: 8px 0; line-height: 1.3;">{data.h1}</h1>
          <div class="article-meta">
            <span>作者: vpnjichang.wiki 客户端技术组</span>
            <span>审核状态: 已验证通过</span>
          </div>
        </header>

        <div class="article-conclusion-box">
          <div class="conclusion-title">本篇核心要点</div>
          <p style="margin: 0; color: #166534; font-size: 0.95rem; line-height: 1.6;">{data.summary}</p>
        </div>

        <div class="article-content">
          <Content />

          {data.faq && data.faq.length > 0 && (
            <div style="margin-top: 40px; padding: 24px; background: var(--bg-alt); border-radius: 8px; border: 1px solid var(--border-color);">
              <h3 style="margin-top: 0; color: var(--text-color); font-size: 1.25rem;">💡 常见问题与排错答疑 (FAQ)</h3>
              {data.faq.map(f => (
                <div style="margin-bottom: 16px;">
                  <strong style="color: #0f172a; font-size: 0.98rem;">问：{f.q}</strong>
                  <p style="margin: 6px 0 0 0; color: #475569; font-size: 0.92rem; line-height: 1.6;">答：{f.a}</p>
                </div>
              ))}
            </div>
          )}

          <!-- 上一篇 / 下一篇 教程导航 -->
          <PaginationNav
            prev={prevRef}
            next={nextRef}
            type="guide"
            indexUrl="/guides/index.html"
          />

          <!-- 推荐相关实操教程 -->
          <RelatedArticles
            title="📱 推荐相关客户端实操教程"
            items={relatedItems}
            moreUrl="/guides/index.html"
            moreText="浏览全部 30 篇配置指南 &rarr;"
          />

          <!-- 全站核心资源互联直达 -->
          <SiteInternalLinks />
        </div>
      </article>
      <Sidebar />
    </div>
  </main>
</BaseLayout>
