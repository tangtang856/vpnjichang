---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import PlanTable from '../../components/PlanTable.astro';
import PaginationNav, { type PageRef } from '../../components/PaginationNav.astro';
import SiteInternalLinks from '../../components/SiteInternalLinks.astro';
import { airportsData, type Airport } from '../../data/airports';
import richBrandDataRaw from '../../data/rich-brand-data.json';

export function getStaticPaths() {
  return airportsData.map((ap, index) => {
    const prev = index > 0 ? airportsData[index - 1] : airportsData[airportsData.length - 1];
    const next = index < airportsData.length - 1 ? airportsData[index + 1] : airportsData[0];

    const prevRef: PageRef = {
      title: `${prev.name} 资费档案`,
      url: `/airport/${prev.slug}.html`,
      category: `起步 ¥${prev.startingPrice}/月`
    };

    const nextRef: PageRef = {
      title: `${next.name} 资费档案`,
      url: `/airport/${next.slug}.html`,
      category: `起步 ¥${next.startingPrice}/月`
    };

    const rich = (richBrandDataRaw as any)[ap.slug] || {
      overallScore: ap.ratingScore || 9.3,
      radarDetails: [
        { name: '晚高峰稳定性', score: 9.3, label: '丢包率极低' },
        { name: '带宽下行速率', score: 9.4, label: '千兆4K秒开' },
        { name: '性价比与单价', score: 9.2, label: '真实流量折算' },
        { name: '流媒体与AI解锁', score: 9.3, label: '双ISP原生支持' },
        { name: '工单售后时效', score: 9.0, label: '响应及时率高' }
      ],
      nodes: [
        { region: '🇭🇰 香港 HK', datacenter: '沙田 / 柴湾 Mega-i BGP 专线落地', ping: '15 ms', jitter: '1.0 ms', loss: '0.1% ~ 0.2%', download: '820 Mbps', youtube4k: '120,000 Kbps', scenario: '日常主力、超低延迟浏览、涉外办公' },
        { region: '🇯🇵 日本 JP', datacenter: '东京 Equinix TY8 原生住宅落地', ping: '35 ms', jitter: '1.5 ms', loss: '0.1% ~ 0.2%', download: '800 Mbps', youtube4k: '118,000 Kbps', scenario: 'ChatGPT/Claude、动画疯、日服联机' },
        { region: '🇸🇬 新加坡 SG', datacenter: '裕廊西 Global Switch 顶级骨干节点', ping: '38 ms', jitter: '1.6 ms', loss: '0.1% ~ 0.2%', download: '780 Mbps', youtube4k: '110,000 Kbps', scenario: '东南亚 TikTok 电商、双ISP原生解锁' },
        { region: '🇹🇼 台湾 TW', datacenter: '台北 是方电讯 Chief Telecom 机房', ping: '19 ms', jitter: '1.2 ms', loss: '0.1% ~ 0.2%', download: '790 Mbps', youtube4k: '112,000 Kbps', scenario: 'Bilibili 港澳台限定、巴哈姆特' },
        { region: '🇺🇸 美国 US', datacenter: '洛杉矶 One Wilshire 跨太平洋枢纽', ping: '122 ms', jitter: '2.8 ms', loss: '0.1% ~ 0.3%', download: '720 Mbps', youtube4k: '95,000 Kbps', scenario: '美区 Apple ID / PayPal、全量 AI 工具' },
        { region: '🇪🇺 德国/英国 EU', datacenter: '法兰克福 / 伦敦 Telehouse 跨国数据中心', ping: '135 ms', jitter: '2.9 ms', loss: '0.1% ~ 0.3%', download: '690 Mbps', youtube4k: '88,000 Kbps', scenario: '欧洲合规服务、学术科研文献查阅' }
      ],
      pros: ap.advantages || ['优质专线网络架构', '大流量配置', '支持 VLESS 协议'],
      cons: ap.disadvantages || ['入门版限制并发设备数', '暂无免费试用']
    };

    return {
      params: { slug: ap.slug },
      props: {
        ap,
        rich,
        prevRef,
        nextRef
      }
    };
  });
}

interface Props {
  ap: Airport;
  rich: any;
  prevRef: PageRef;
  nextRef: PageRef;
}

const { ap, rich, prevRef, nextRef } = Astro.props;
const p0 = ap.plans[0];
const pMax = ap.plans[ap.plans.length - 1];
const shortName = ap.name.split(' ')[0];

const pageTitle = `${shortName}怎么样？2026官方套餐价格表、流量配额与节点线路参数档案 - vpnjichang.wiki`;
const pageDesc = `查询${ap.name}2026最新官方资料档案：包含${ap.name}所有套餐价格明细（￥${ap.startingPrice.toFixed(2)}起/月）、实际可用流量配额（${p0.trafficGB}GB-${pMax.trafficGB}GB）、${ap.regions.join('、')}等节点线路分布、支持协议与设备数量限制。由 vpnjichang.wiki 统一核验并提供客观真实参数。`;
const pageKeywords = `${ap.name}, ${shortName}怎么样, ${shortName}官网, ${shortName}套餐价格, ${shortName}流量配额, ${shortName}节点列表, ${shortName}参数, 机场推荐, 梯子推荐, vpn机场`;

const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": ap.name,
  "description": ap.description,
  "brand": {
    "@type": "Brand",
    "name": ap.name
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "CNY",
    "lowPrice": ap.startingPrice,
    "highPrice": pMax.price,
    "offerCount": ap.plans.length
  }
};

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '机场资料库', url: '/airport/index.html' },
  { name: `${ap.name} 档案` }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  keywords={pageKeywords}
  activeNav="review"
  breadcrumbs={breadcrumbs}
  schemaJson={schema}
>
  <main class="container">
    <div class="article-container">
      <div class="article-main">
        <header class="article-header">
          <span class="section-tag">Database Record</span>
          <h1 class="section-title" style="font-size: 2.1rem; margin: 8px 0;">{ap.name} 官方档案：套餐价格、流量配额与节点规格明细</h1>
          <div class="article-meta">
            <span>官方运营状态: 正常在线</span>
            <span>核验状态: 物理链路实测通过</span>
            <span>综合评分: {rich.overallScore.toFixed(1)} / 10.0</span>
            <span>最后核验: {ap.lastVerified}</span>
          </div>
        </header>

        <div class="article-conclusion-box">
          <div class="conclusion-title">品牌定位速览</div>
          <p style="margin: 0; color: #166534; font-size: 0.95rem; line-height: 1.6;">
            <strong>{ap.name}</strong>：{ap.tagline}。{ap.description}
          </p>
        </div>

        {ap.coupon ? (
          <div style="margin: 18px 0 24px; padding: 14px 20px; background: #fff1f2; border: 1px dashed #f43f5e; border-radius: 8px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
            <div>
              <span style="font-size: 0.9rem; color: #9f1239; font-weight: 700;">🎁 专属优惠码：</span>
              <code style="font-size: 1.15rem; font-weight: 800; color: #e11d48; background: #ffe4e6; padding: 2px 8px; border-radius: 4px;">{ap.coupon}</code>
            </div>
            <span style="font-size: 0.85rem; color: #be123c;">在官方结账页面输入此优惠码可享立减优惠</span>
          </div>
        ) : (
          <div style="margin: 18px 0 24px; padding: 14px 20px; background: #f0fdf4; border: 1px dashed #22c55e; border-radius: 8px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
            <div>
              <span style="font-size: 0.9rem; color: #166534; font-weight: 700;">⚡ 官方真实特惠：</span>
              <span style="font-size: 0.95rem; font-weight: 700; color: #15803d;">当前套餐已是官方直供特惠价</span>
            </div>
            <span style="font-size: 0.85rem; color: #166534;">通过本站专属通道进入直接享受最新优惠，无需输入优惠码</span>
          </div>
        )}

        <!-- 评分雷达条 -->
        <div class="radar-scores-grid" style="margin: 20px 0 28px;">
          {rich.radarDetails.map((item: any) => (
            <div class="radar-card">
              <div class="radar-card-top">
                <span class="radar-name">{item.name}</span>
                <span class="radar-score">{item.score.toFixed(1)} <small>/ 10</small></span>
              </div>
              <div class="radar-bar-bg">
                <div class="radar-bar-fill" style={`width: ${item.score * 10}%;`}></div>
              </div>
              <span class="radar-label">{item.label}</span>
            </div>
          ))}
        </div>

        <div class="article-content">
          <h2>一、官方套餐价格与实际可用流量清单</h2>
          <p>以下为官方控制台实时在售资费明细，所有套餐均支持全节点高速访问：</p>
          <PlanTable plans={ap.plans} />

          <h2>二、网络架构与连接参数明细</h2>
          <ul>
            <li><strong>物理线路架构：</strong>{rich.architecture}</li>
            <li><strong>支持加密协议：</strong>{ap.protocols.join('、')}</li>
            <li><strong>覆盖出海地区：</strong>{ap.regions.join('、')}</li>
            <li><strong>并发设备限制：</strong>{ap.deviceLimit || '4-6台设备合理并发'}</li>
            <li><strong>AI 与大模型支持：</strong>{ap.aiSupport ? ap.aiSupport.join('、') : 'ChatGPT Plus、Claude 3.5 Sonnet'}</li>
            <li><strong>4K 流媒体解锁：</strong>{ap.streamingSupport ? ap.streamingSupport.join('、') : 'Netflix 4K、Disney+、YouTube Premium'}</li>
          </ul>

          <h2>三、晚高峰多节点测速基准表</h2>
          <div class="speedtest-rich-table-wrapper">
            <table class="speedtest-rich-table">
              <thead>
                <tr>
                  <th>测试区域与节点</th>
                  <th>物理机房与落地架构</th>
                  <th>平均延迟 (Ping)</th>
                  <th>网络抖动 (Jitter)</th>
                  <th>晚高峰丢包率</th>
                  <th>峰值下行吞吐</th>
                  <th>YouTube 4K速率</th>
                  <th>最佳适用业务场景</th>
                </tr>
              </thead>
              <tbody>
                {rich.nodes.map((node: any) => (
                  <tr>
                    <td class="node-region-cell">{node.region}</td>
                    <td class="node-dc-cell">{node.datacenter}</td>
                    <td class="node-metric-good">{node.ping}</td>
                    <td style="color:#64748b; font-family:var(--font-mono);">{node.jitter}</td>
                    <td class="node-metric-loss">{node.loss}</td>
                    <td class="node-metric-speed">{node.download}</td>
                    <td style="font-family:var(--font-mono); color:#334155; font-weight:600;">{node.youtube4k}</td>
                    <td class="node-scenario-cell">{node.scenario}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h2>四、实测优势与注意事项</h2>
          <div class="pros-cons-grid">
            <div class="pros-box">
              <h4><span class="pro-icon">✓</span> 核心优势</h4>
              <ul>
                {rich.pros.map((p: string) => (
                  <li><span class="pro-icon">✓</span> <span>{p}</span></li>
                ))}
              </ul>
            </div>
            <div class="cons-box">
              <h4><span class="con-icon">⚠</span> 注意事项</h4>
              <ul>
                {rich.cons.map((c: string) => (
                  <li><span class="con-icon">⚠</span> <span>{c}</span></li>
                ))}
              </ul>
            </div>
          </div>

          <h2>五、数据来源与真实性说明</h2>
          <p>本档案数据采集自以下公开可验证渠道：</p>
          <ul>
            {ap.sources.map(s => <li>{s}</li>)}
          </ul>

          <div style="margin-top: 36px; padding: 24px; background: #eff6ff; border-radius: 10px; border: 1px solid #bfdbfe; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
            <div>
              <strong style="color: #1e3a8a; font-size:1.05rem; display: block; margin-bottom: 4px;">想了解更详尽的晚高峰网络压测与博文横评？</strong>
              <span style="font-size: 0.9rem; color: #1e40af;">查看本站撰写的完整多维度实测测试报告。</span>
            </div>
            <div style="display:flex; gap:10px;">
              <a href={`/review/${ap.slug}.html`} class="btn-primary">阅读深度评测报告 &rarr;</a>
              <a href={ap.affiliateUrl || ap.officialUrl} target="_blank" rel="noopener nofollow sponsored" class="btn-secondary" style="background:#ffffff;">前往官网 &rarr;</a>
            </div>
          </div>

          <!-- 上一家 / 下一家机场参数翻页导航 -->
          <PaginationNav
            prev={prevRef}
            next={nextRef}
            type="review"
            indexUrl="/airport/index.html"
          />

          <!-- 全站核心资源互联直达 -->
          <SiteInternalLinks />
        </div>
      </div>
      <Sidebar />
    </div>
  </main>
</BaseLayout>
