---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { glossaryTopics } from '../../data/topics';

const title = '网络代理与翻墙技术专业术语词典 · 知识百科中心 - vpnjichang.wiki';
const description = 'vpnjichang.wiki 网络代理技术词典。收录 IPLC/IEPL、Clash Meta、Sing-box、Shadowsocks、VLESS 及节点倍率等专有名词权威解析。';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '知识百科中心' }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "网络代理与翻墙技术词典",
  "itemListElement": glossaryTopics.map((g, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": g.h1,
    "url": `https://vpnjichang.wiki/glossary/${g.slug}.html`
  }))
};
---

<BaseLayout
  title={title}
  description={description}
  activeNav="glossary"
  breadcrumbs={breadcrumbs}
  schemaJson={schema}
>
  <main class="container" style="padding-bottom: 60px;">
    <div class="section-header" style="margin-top: 20px;">
      <span class="section-tag">Technical Glossary</span>
      <h1 class="section-title">网络代理与翻墙技术专业术语词典</h1>
      <p class="section-desc">
        用通俗易懂的专业语言，拆解网络代理与出海加速领域的复杂专有名词。
      </p>
    </div>
    <div class="cards-grid">
      {glossaryTopics.map(g => (
        <div class="airport-card">
          <h3 class="airport-brand-name"><a href={`/glossary/${g.slug}.html`}>{g.h1}</a></h3>
          <p class="card-desc">{g.summary}</p>
          <div style="margin-top:auto; font-size:0.88rem;">
            <a href={`/glossary/${g.slug}.html`} class="btn-card-review">查阅术语解析 &rarr;</a>
          </div>
        </div>
      ))}
    </div>
  </main>
</BaseLayout>
