---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { airportsData, brandBenchmarks } from '../../data/airports';

const title = '机场独立深度评测中心 · 2026节点测速与稳定性体验 - vpnjichang.wiki';
const description = 'vpnjichang.wiki 机场独立评测专区。覆盖主流机场套餐价格折算、晚高峰丢包延迟监测、4K流媒体解锁与 AI 专线兼容性评测。';
const keywords = '机场评测, 机场测评, 节点测速, 机场稳定性测试, 机场推荐, 梯子推荐, vpn机场, vpn节点';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '机场评测中心' }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "机场独立深度评测中心",
  "description": description,
  "itemListElement": airportsData.map((ap, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": `${ap.name} 深度评测`,
    "url": `https://vpnjichang.wiki/review/${ap.slug}.html`
  }))
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  activeNav="review"
  breadcrumbs={breadcrumbs}
  schemaJson={schema}
>
  <main class="container" style="padding-bottom: 60px;">
    <div class="section-header" style="margin-top: 20px;">
      <span class="section-tag">In-depth Review Center</span>
      <h1 class="section-title">机场独立深度评测中心</h1>
      <p class="section-desc">
        拒绝商业充值软文。我们通过真实宽带环境的多点压测、流媒体全区解锁验证与长期在线监测，为您呈现各品牌真实的服务水准。
      </p>
    </div>
    <div class="cards-grid">
      {airportsData.map(ap => {
        const bm = brandBenchmarks[ap.id] || { shortName: ap.name.split(' ')[0], lowPing: 20, peakDown: 600 };
        return (
          <div class="airport-card">
            <div class="card-header">
              <h3 class="airport-brand-name"><a href={`/review/${ap.slug}.html`}>{bm.shortName}评测</a></h3>
              <span class="airport-badge badge-stable">{ap.testStatus === 'tested' ? '实测报告' : '官方整理'}</span>
            </div>
            <div class="card-tagline">{ap.tagline}</div>
            <p class="card-desc">{ap.description}</p>
            <div class="card-specs">
              <div class="spec-item"><span class="spec-label">入门起步</span><span class="spec-value">￥{ap.startingPrice.toFixed(2)}/月</span></div>
              <div class="spec-item"><span class="spec-label">实测延迟</span><span class="spec-value">低至 {bm.lowPing}ms</span></div>
              <div class="spec-item"><span class="spec-label">峰值带宽</span><span class="spec-value">{bm.peakDown} Mbps</span></div>
              <div class="spec-item"><span class="spec-label">核心协议</span><span class="spec-value">{ap.protocols.slice(0, 2).join(', ')}</span></div>
            </div>
            <div class="card-footer">
              <a href={`/review/${ap.slug}.html`} class="btn-card-review">阅读评测全文</a>
              <a href={ap.affiliateUrl || ap.officialUrl} target="_blank" rel="noopener nofollow sponsored" class="btn-card-buy">前往官网</a>
            </div>
          </div>
        );
      })}
    </div>
  </main>
</BaseLayout>
