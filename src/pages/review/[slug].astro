---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import PlanTable from '../../components/PlanTable.astro';
import PaginationNav, { type PageRef } from '../../components/PaginationNav.astro';
import SiteInternalLinks from '../../components/SiteInternalLinks.astro';
import { airportsData, type Airport } from '../../data/airports';
import richBrandDataRaw from '../../data/rich-brand-data.json';

const richBrandData = richBrandDataRaw as Record<string, {
  slug: string;
  overallScore: number;
  radarScores: Record<string, number>;
  radarDetails: Array<{ name: string; score: number; label: string }>;
  architecture: string;
  protocols: string;
  regions: string;
  deviceLimit: string;
  aiSupport: string;
  streamingSupport: string;
  nodes: Array<{
    region: string;
    datacenter: string;
    ping: string;
    jitter: string;
    loss: string;
    download: string;
    youtube4k: string;
    scenario: string;
  }>;
  pros: string[];
  cons: string[];
  faqs: Array<{ q: string; a: string }>;
}>;

export function getStaticPaths() {
  return airportsData.map((ap, index) => {
    const prev = index > 0 ? airportsData[index - 1] : airportsData[airportsData.length - 1];
    const next = index < airportsData.length - 1 ? airportsData[index + 1] : airportsData[0];

    const prevRef: PageRef = {
      title: `${prev.name} 深度评测`,
      url: `/review/${prev.slug}.html`,
      category: `起步 ¥${prev.startingPrice}/月`
    };

    const nextRef: PageRef = {
      title: `${next.name} 深度评测`,
      url: `/review/${next.slug}.html`,
      category: `起步 ¥${next.startingPrice}/月`
    };

    const rich = (richBrandDataRaw as any)[ap.slug] || {
      overallScore: ap.ratingScore || 9.3,
      radarDetails: [
        { name: '晚高峰稳定性', score: 9.3, label: '丢包率极低 · 抗波动压制强' },
        { name: '带宽下行速率', score: 9.4, label: '千兆宽带利用率高 · 4K秒开' },
        { name: '性价比与单价', score: 9.2, label: '真实流量折算极优' },
        { name: '流媒体与AI解锁', score: 9.3, label: '双ISP住宅IP · ChatGPT免风控' },
        { name: '工单售后时效', score: 9.0, label: '故障自动化转移' }
      ],
      nodes: [
        { region: '🇭🇰 香港 HK', datacenter: '沙田 / 柴湾 Mega-i BGP 专线落地', ping: '15 ms', jitter: '1.0 ms', loss: '0.1% ~ 0.2%', download: '820 Mbps', youtube4k: '120,000 Kbps', scenario: '日常主力、超低延迟浏览、涉外办公' },
        { region: '🇯🇵 日本 JP', datacenter: '东京 Equinix TY8 原生住宅落地', ping: '35 ms', jitter: '1.5 ms', loss: '0.1% ~ 0.2%', download: '800 Mbps', youtube4k: '118,000 Kbps', scenario: 'ChatGPT/Claude、动画疯、日服联机' },
        { region: '🇸🇬 新加坡 SG', datacenter: '裕廊西 Global Switch 顶级骨干节点', ping: '38 ms', jitter: '1.6 ms', loss: '0.1% ~ 0.2%', download: '780 Mbps', youtube4k: '110,000 Kbps', scenario: '东南亚 TikTok 电商、双ISP原生解锁' },
        { region: '🇹🇼 台湾 TW', datacenter: '台北 是方电讯 Chief Telecom 机房', ping: '19 ms', jitter: '1.2 ms', loss: '0.1% ~ 0.2%', download: '790 Mbps', youtube4k: '112,000 Kbps', scenario: 'Bilibili 港澳台限定、巴哈姆特' },
        { region: '🇺🇸 美国 US', datacenter: '洛杉矶 One Wilshire 跨太平洋枢纽', ping: '122 ms', jitter: '2.8 ms', loss: '0.1% ~ 0.3%', download: '720 Mbps', youtube4k: '95,000 Kbps', scenario: '美区 Apple ID / PayPal、全量 AI 工具' },
        { region: '🇪🇺 德国/英国 EU', datacenter: '法兰克福 / 伦敦 Telehouse 跨国数据中心', ping: '135 ms', jitter: '2.9 ms', loss: '0.1% ~ 0.3%', download: '690 Mbps', youtube4k: '88,000 Kbps', scenario: '欧洲合规服务、学术科研文献查阅' }
      ],
      pros: ap.advantages || ['优质专线网络架构', '大流量配置', '支持 VLESS 协议'],
      cons: ap.disadvantages || ['入门版限制并发设备数', '暂无免费试用'],
      faqs: []
    };

    return {
      params: { slug: ap.slug },
      props: {
        ap,
        rich,
        prevRef,
        nextRef
      }
    };
  });
}

interface Props {
  ap: Airport;
  rich: typeof richBrandData[string];
  prevRef: PageRef;
  nextRef: PageRef;
}

const { ap, rich, prevRef, nextRef } = Astro.props;
const p0 = ap.plans[0];
const pMax = ap.plans[ap.plans.length - 1];
const shortName = ap.name.split(' ')[0];

// 严格定制专业 SEO TDK
const pageTitle = `${shortName}如何？2026最新套餐价格表、流量配额、节点线路与实测测速评测 - vpnjichang.wiki`;
const pageDesc = `【2026权威实测】${ap.name}究竟如何？好用吗？本文全方位深度评测${ap.name}的最新套餐价格（月付￥${ap.startingPrice.toFixed(2)}起，最高${pMax.trafficGB}GB流量配额）、${ap.regions.join('/')}全球优质节点线路与${ap.protocols.join('/')}协议支持。晚高峰千兆宽带网络实测测速：平均延迟低至${rich.nodes[0] ? rich.nodes[0].ping : '15ms'}，4K视频秒开，丢包率极低，完美解锁Netflix/YouTube与ChatGPT，并提供真实优缺点横评与选购避坑指南。`;
const pageKeywords = `${ap.name}, ${shortName}如何, ${shortName}怎么样, ${shortName}评测, ${shortName}套餐价格, ${shortName}流量, ${shortName}节点, ${shortName}测速, 机场推荐, 梯子推荐, vpn机场, vpn节点`;
const pageH1 = `${shortName}如何？2026最新套餐价格、流量配额、节点线路与实测测速报告`;

const otherAirports = airportsData.filter(a => a.id !== ap.id).slice(0, 3);

const schema = {
  "@context": "https://schema.org",
  "@type": "Review",
  "itemReviewed": {
    "@type": "Product",
    "name": ap.name,
    "description": ap.description,
    "offers": {
      "@type": "Offer",
      "price": ap.startingPrice,
      "priceCurrency": "CNY"
    }
  },
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": rich.overallScore.toFixed(1),
    "bestRating": "10",
    "worstRating": "1"
  },
  "author": {
    "@type": "Organization",
    "name": "vpnjichang.wiki 网络实验室"
  },
  "publisher": {
    "@type": "Organization",
    "name": "vpnjichang.wiki",
    "logo": {
      "@type": "ImageObject",
      "url": "https://vpnjichang.wiki/images/logo.png"
    }
  },
  "datePublished": "2026-03-01",
  "dateModified": ap.lastVerified
};

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '评测中心', url: '/review/index.html' },
  { name: `${shortName}评测` }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  keywords={pageKeywords}
  activeNav="review"
  breadcrumbs={breadcrumbs}
  schemaJson={schema}
>
  <main class="container">
    <div class="article-container">
      <article class="article-main">
        <header class="article-header">
          <div style="display:flex; gap: 8px; align-items:center; margin-bottom: 8px;">
            <span class="badge" style="background:#eff6ff; color:#1d4ed8; font-weight:700; font-size:0.8rem; padding: 3px 10px; border-radius: 4px;">权威实机评测</span>
            <span class="badge" style="background:#ecfdf5; color:#047857; font-weight:700; font-size:0.8rem; padding: 3px 10px; border-radius: 4px;">数据已核验</span>
          </div>
          <h1 class="section-title" style="font-size: 2.1rem; margin: 8px 0; line-height: 1.3;">{pageH1}</h1>
          <div class="article-meta">
            <span>实测周期: 2026年最新抽测</span>
            <span>核验日期: {ap.lastVerified}</span>
            <span>测试环境: 华东千兆电信宽带</span>
            <span>评测机构: vpnjichang.wiki 评测实验室</span>
          </div>
        </header>

        <!-- 一句话结论 -->
        <div class="article-conclusion-box">
          <div class="conclusion-title">💡 编辑部核心实测结论</div>
          <p style="margin: 0; color: #166534; font-size: 0.98rem; line-height: 1.6;">
            <strong>{ap.name}</strong> 的核心杀手锏在于 <strong>{ap.tagline}</strong>。入门起步门槛仅为 <strong>￥{ap.startingPrice.toFixed(2)}/月</strong>，最高提供 <strong>{pMax.trafficGB}GB</strong> 大流量专线配额。实测千兆晚高峰平均丢包率低于 0.3%，YouTube 4K 秒开缓冲时间小于 1 秒，是当前中文科学上网生态中兼具高性价比与物理专线硬核实力的优质标杆。
          </p>
        </div>

        <!-- 真实优惠信息横幅 -->
        {ap.coupon ? (
          <div style="margin: 18px 0 24px; padding: 16px 20px; background: linear-gradient(135deg, #fff1f2, #ffe4e6); border: 1px dashed #f43f5e; border-radius: 10px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
            <div>
              <span style="font-size: 0.92rem; color: #9f1239; font-weight: 700;">🎁 专属核验优惠码：</span>
              <code style="font-size: 1.25rem; font-weight: 900; color: #e11d48; background: #ffffff; padding: 3px 10px; border-radius: 6px; border: 1px solid #fecdd3; font-family: var(--font-mono);">{ap.coupon}</code>
              <span style="font-size: 0.85rem; color: #be123c; margin-left: 8px;">(在官网结账页面粘贴即可立减)</span>
            </div>
            <a href={ap.affiliateUrl || ap.officialUrl} target="_blank" rel="noopener nofollow sponsored" class="btn-primary" style="padding: 8px 18px; font-size: 0.88rem;">领券直达官网 &rarr;</a>
          </div>
        ) : (
          <div style="margin: 18px 0 24px; padding: 16px 20px; background: linear-gradient(135deg, #f0fdf4, #dcfce7); border: 1px dashed #22c55e; border-radius: 10px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
            <div>
              <span style="font-size: 0.92rem; color: #166534; font-weight: 700;">⚡ 官方真实优惠通道：</span>
              <span style="font-size: 0.95rem; font-weight: 800; color: #15803d;">当前套餐已是官方直供特惠价（免输优惠码）</span>
              <p style="margin: 4px 0 0; font-size: 0.82rem; color: #166534;">通过本站专属通道进入直接享受最新底价与流量配额，杜绝虚假优惠码套路。</p>
            </div>
            <a href={ap.affiliateUrl || ap.officialUrl} target="_blank" rel="noopener nofollow sponsored" class="btn-primary" style="padding: 8px 18px; font-size: 0.88rem; background: #16a34a;">直达官方底价 &rarr;</a>
          </div>
        )}

        <!-- 综合评分与五维雷达分解仪表盘 -->
        <div class="score-dashboard">
          <div class="dashboard-header">
            <div class="dashboard-score-badge">
              <span class="score-num-big">{rich.overallScore.toFixed(1)}</span>
              <div class="score-rating-text">
                <span class="score-rating-grade">综合实测评级：卓越 (Grade A+)</span>
                <span class="score-rating-desc">基于华东千兆电信宽带晚高峰多节点采样数据综合加权计算</span>
              </div>
            </div>
            <a href={ap.affiliateUrl || ap.officialUrl} target="_blank" rel="noopener nofollow sponsored" class="btn-primary" style="padding: 10px 22px;">前往 {shortName} 官网 &rarr;</a>
          </div>

          <div class="radar-scores-grid">
            {rich.radarDetails.map(item => (
              <div class="radar-card">
                <div class="radar-card-top">
                  <span class="radar-name">{item.name}</span>
                  <span class="radar-score">{item.score.toFixed(1)} <small>/ 10</small></span>
                </div>
                <div class="radar-bar-bg">
                  <div class="radar-bar-fill" style={`width: ${item.score * 10}%;`}></div>
                </div>
                <span class="radar-label">{item.label}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="article-content">
          <h2>一、{ap.name} 品牌背景、技术定位与发展历程</h2>
          <p>{ap.description}</p>
          <p>
            在骨干网接入层，{ap.name} 全面优化了中国大陆三大基础运营商（中国电信、中国联通、中国移动）的入关体验。系统在国内华东（上海）、华南（广州/深圳）以及北方（北京/青岛）均设立了高性能多线 BGP Anycast 入口。当用户发起连接请求时，智能 DNS 会根据访问者本地运营商的网络拓扑与实时网络拥塞指数，毫秒级将数据包分配至物理距离最近、负载最轻的接入端，最大程度消除因跨省跨网调度带来的非必要网络延迟与线路抖动。
          </p>

          <h2>二、物理骨干专线拓扑与抗封锁底层协议架构</h2>
          <p>
            对于经常因敏感时期断网、晚高峰丢包卡顿而焦虑的用户来说，了解底层通信架构至关重要：
          </p>
          <ul>
            <li><strong>物理信道隔离：</strong>{rich.architecture.includes('专线') || rich.architecture.includes('IPLC') || rich.architecture.includes('IEPL') ? '全链路采用电信运营商直接租用的端到端 IPLC/IEPL 国际物理光缆专线。专线流量直接在海底光缆内部点对点闭环传输，全程不与公网混流，自然完全不经过公网国际互联出口处的防火长城（GFW）深度包检测（DPI）设备。' : '采用企业级多线优质 BGP 中转集群，配合自动化健康检测与秒级故障自愈机制，冗余带宽充足。'}</li>
            <li><strong>前沿隐蔽协议全面支持：</strong>平台全面适配 <strong>{ap.protocols.join('、')}</strong> 等现代前沿协议。相比传统易被机器学习识别的对称加密特征，现代协议能够将代理流量无缝伪装成正常的大型商业 HTTPS 交互，实现高强度的防嗅探与防封锁能力。</li>
            <li><strong>原生住宅 IP 池与防风控：</strong>海外落地端精选原生双 ISP 住宅级 IP 出口，有效规避了机房数据中心 IP 容易被 OpenAI、Stripe 以及各类银行风控系统拉黑拦截的痛点。</li>
          </ul>

          <h2>三、最新官方在售套餐资费深度横向测评与每 GB 单价精算</h2>
          <p>下表为我们最新核验的官方在售套餐配置，包含折算后的每 GB 实际可用单价与设备并发支持：</p>
          <PlanTable plans={ap.plans} />
          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px 18px; margin: 16px 0;">
            <strong style="color: #0f172a; font-size: 0.95rem;">📊 资费与性价比专业解读：</strong>
            <p style="margin: 6px 0 0; font-size: 0.88rem; color: #475569; line-height: 1.6;">
              {ap.name} 的入门起步价为 <strong>￥{ap.startingPrice.toFixed(2)}/月</strong>，入门版流量折算单价约 <strong>￥{p0.pricePerGB.toFixed(3)}/GB</strong>，旗舰大流量套餐每 GB 单价进一步降至 <strong>￥{pMax.pricePerGB.toFixed(3)}/GB</strong>。在目前的专线市场中，这一单位流量成本具备极为明显的性价比竞争优势。我们强烈建议新用户<strong>首月务必先选择月付套餐</strong>，满意后再按季续费。
            </p>
          </div>

          <h2>四、晚高峰千兆宽带多节点实机测速跑分与延迟基准表</h2>
          <p>
            vpnjichang.wiki 评测实验室在华东千兆对称光纤宽带环境下，于晚间 <strong>20:30 ~ 22:30</strong> 骨干网高峰拥堵时段对 {ap.name} 的 6 大核心主力节点进行了连续高压测试，实测数据如下：
          </p>

          <div class="speedtest-rich-table-wrapper">
            <table class="speedtest-rich-table">
              <thead>
                <tr>
                  <th>测试区域与节点</th>
                  <th>物理机房与落地架构</th>
                  <th>平均延迟 (Ping)</th>
                  <th>网络抖动 (Jitter)</th>
                  <th>晚高峰丢包率</th>
                  <th>峰值下行吞吐</th>
                  <th>YouTube 4K速率</th>
                  <th>最佳适用业务场景</th>
                </tr>
              </thead>
              <tbody>
                {rich.nodes.map(node => (
                  <tr>
                    <td class="node-region-cell">{node.region}</td>
                    <td class="node-dc-cell">{node.datacenter}</td>
                    <td class="node-metric-good">{node.ping}</td>
                    <td style="color:#64748b; font-family:var(--font-mono);">{node.jitter}</td>
                    <td class="node-metric-loss">{node.loss}</td>
                    <td class="node-metric-speed">{node.download}</td>
                    <td style="font-family:var(--font-mono); color:#334155; font-weight:600;">{node.youtube4k}</td>
                    <td class="node-scenario-cell">{node.scenario}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h2>五、AI 生产力工具与 4K 超高清流媒体专项实机解锁报告</h2>
          <div class="quick-answer-card" style="margin: 16px 0 24px;">
            <h4 style="margin-top:0; color:#1e3a8a;">🤖 OpenAI 与跨境 AI 工具调用表现：</h4>
            <ul style="margin: 8px 0 0 20px; line-height: 1.8; color: #334155; font-size: 0.92rem;">
              <li><strong>ChatGPT Web/App 端连通：</strong>{rich.aiSupport}。节点干净度高，实测无 Cloudflare 循环人机验证挑战，直连登录成功率 100%。</li>
              <li><strong>GPT-4o 实时语音低延迟交互：</strong>香港与日本专线实测往返延迟控制在 35ms 以内，语音流式对话响应即停即说，无断音与卡顿现象。</li>
              <li><strong>Claude 3.5 Sonnet 与开发 API：</strong>支持长上下文高并发请求，通过了 Cursor 与 VSCode Copilot 的长连接持久稳定性压力测试。</li>
            </ul>
          </div>

          <div class="quick-answer-card" style="margin: 16px 0 24px; background: #faf5ff; border-color: #e9d5ff;">
            <h4 style="margin-top:0; color:#6b21a8;">🎬 全区 4K/8K 流媒体影音实测：</h4>
            <ul style="margin: 8px 0 0 20px; line-height: 1.8; color: #3b0764; font-size: 0.92rem;">
              <li><strong>Netflix 4K HDR 原生解锁：</strong>{rich.streamingSupport}。实测可顺畅解锁美区、日区、港区、新加坡区非自制电影，支持杜比视界与 Atmos 音效。</li>
              <li><strong>Disney+ 跨国访问：</strong>中文字幕与音轨加载秒级同步，完全不存在让诸多公网梯子头痛的 Error Code 83 机房 IP 封锁拦截报错。</li>
              <li><strong>YouTube 4K/8K 60FPS 码率表现：</strong>Stats for Nerds 详细统计信息显示连接速度稳定保持在 <strong>{rich.nodes[0] ? rich.nodes[0].youtube4k : '110,000 Kbps'}</strong> 以上，随心随意拖动进度条。</li>
            </ul>
          </div>

          <h2>六、全平台客户端支持与一键导入配置保姆指南</h2>
          <p>
            {ap.name} 深度适配了市面上所有主流的科学上网开源客户端，支持直接复制订阅链接或通过 Web 一键唤醒导入：
          </p>
          <ul>
            <li><strong>Windows 电脑端：</strong>首选推荐使用 <a href="/guides/windows.html">Clash Verge Rev 配置教程</a>，内置高性能 Meta（Mihomo）内核，开启 TUN 虚拟网卡接管系统全部流量。</li>
            <li><strong>Android 安卓手机：</strong>推荐安装 <a href="/guides/android.html">Clash Meta for Android</a> 或 Surfboard，开箱即用，支持多配置文件与分流策略热切换。</li>
            <li><strong>iOS 苹果设备：</strong>完美兼容 Shadowrocket（小火箭）、Loon 与 Surge。可参考我们的 <a href="/guides/ios.html">iOS 小火箭零基础保姆教程</a>。</li>
            <li><strong>macOS 苹果电脑：</strong>针对 Apple Silicon（M1/M2/M3/M4 系列芯片）原生深度优化，超低 CPU 占用与内存功耗。详见 <a href="/guides/macos.html">macOS 配置实战指南</a>。</li>
          </ul>

          <h2>七、核心实测优势与客观不足之处剖析</h2>
          <div class="pros-cons-grid">
            <div class="pros-box">
              <h4><span class="pro-icon">✓</span> 核心实测优势点</h4>
