---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import PaginationNav from '../../components/PaginationNav.astro';
import RelatedArticles, { type RelatedItem } from '../../components/RelatedArticles.astro';
import SiteInternalLinks from '../../components/SiteInternalLinks.astro';

export async function getStaticPaths() {
  const blogs = await getCollection('blog');
  // 按日期降序排列，同日期按 slug 排序，确保顺序 100% 稳定一致
  const sortedBlogs = blogs.sort((a, b) => b.data.date.localeCompare(a.data.date) || a.data.slug.localeCompare(b.data.slug));

  return sortedBlogs.map((entry, index) => {
    // 上一篇（较新文章）与 下一篇（较早文章）
    const prev = index > 0 ? sortedBlogs[index - 1] : null;
    const next = index < sortedBlogs.length - 1 ? sortedBlogs[index + 1] : null;

    // 智能筛选 3 篇同分类或高度相关的文章
    let related = sortedBlogs
      .filter(b => b.data.slug !== entry.data.slug && b.data.category === entry.data.category)
      .slice(0, 3);

    // 若同分类不足 3 篇，用其他文章补充
    if (related.length < 3) {
      const others = sortedBlogs.filter(b => b.data.slug !== entry.data.slug && !related.some(r => r.data.slug === b.data.slug));
      related = related.concat(others.slice(0, 3 - related.length));
    }

    const prevRef = prev ? {
      title: prev.data.h1.split(' · ')[0].split('：')[0] || prev.data.title,
      url: `/blog/${prev.data.slug}.html`,
      category: prev.data.category
    } : null;

    const nextRef = next ? {
      title: next.data.h1.split(' · ')[0].split('：')[0] || next.data.title,
      url: `/blog/${next.data.slug}.html`,
      category: next.data.category
    } : null;

    const relatedItems: RelatedItem[] = related.map(r => ({
      title: r.data.h1,
      url: `/blog/${r.data.slug}.html`,
      category: r.data.category,
      date: r.data.date,
      summary: r.data.summary
    }));

    return {
      params: { slug: entry.data.slug },
      props: {
        entry,
        prevRef,
        nextRef,
        relatedItems
      }
    };
  });
}

const { entry, prevRef, nextRef, relatedItems } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '博客文章', url: '/blog/index.html' },
  { name: data.h1.split(' · ')[0].split('：')[0] }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": data.h1,
  "description": data.desc,
  "datePublished": data.date,
  "dateModified": data.date,
  "mainEntityOfPage": `https://vpnjichang.wiki/blog/${data.slug}.html`,
  "inLanguage": "zh-CN",
  "articleSection": data.category,
  "author": {
    "@type": "Organization",
    "name": "vpnjichang.wiki 编辑部",
    "url": "https://vpnjichang.wiki"
  },
  "publisher": {
    "@type": "Organization",
    "name": "vpnjichang.wiki",
    "logo": {
      "@type": "ImageObject",
      "url": "https://vpnjichang.wiki/images/logo.png"
    }
  }
};
---

<BaseLayout
  title={data.title}
  description={data.desc}
  activeNav="blog"
  breadcrumbs={breadcrumbs}
  schemaJson={schema}
>
  <main class="container">
    <div class="article-container">
      <article class="article-main">
        <header class="article-header">
          <div style="display:flex; gap: 8px; align-items:center; margin-bottom: 8px;">
            <span class="badge" style="background:#e2e8f0; color:#334155; font-weight:600; font-size:0.8rem; padding: 3px 10px; border-radius: 4px;">{data.category}</span>
            <span style="font-size: 0.85rem; color: var(--text-muted);">发布于: {data.date}</span>
          </div>
          <h1 class="section-title" style="font-size: 2.1rem; margin: 8px 0; line-height: 1.3;">{data.h1}</h1>
          <div class="article-meta">
            <span>作者: vpnjichang.wiki 专题策划组</span>
            <span>核验状态: 数据与技术规范已核准</span>
          </div>
        </header>

        <div class="article-conclusion-box">
          <div class="conclusion-title">核心速读</div>
          <p style="margin: 0; color: #166534; font-size: 0.95rem; line-height: 1.6;">{data.summary}</p>
        </div>

        <div class="article-content">
          <Content />

          {data.faq && data.faq.length > 0 && (
            <div style="margin-top: 40px; padding: 24px; background: var(--bg-alt); border-radius: 8px; border: 1px solid var(--border-color);">
              <h3 style="margin-top: 0; color: var(--text-color); font-size: 1.25rem;">💡 核心问题释疑 (FAQ)</h3>
              {data.faq.map(f => (
                <div style="margin-bottom: 16px;">
                  <strong style="color: #0f172a; font-size: 0.98rem;">问：{f.q}</strong>
                  <p style="margin: 6px 0 0 0; color: #475569; font-size: 0.92rem; line-height: 1.6;">答：{f.a}</p>
                </div>
              ))}
            </div>
          )}

          <!-- 上一篇 / 下一篇 翻页导航 -->
          <PaginationNav
            prev={prevRef}
            next={nextRef}
            type="blog"
            indexUrl="/blog/index.html"
          />

          <!-- 猜你还想看 · 相关深度阅读 -->
          <RelatedArticles
            title="📚 猜你还想看 · 相关深度精选"
            items={relatedItems}
            moreUrl="/blog/index.html"
            moreText="浏览全部 100 篇深度博文 &rarr;"
          />

          <!-- 全站核心资源互联直达 -->
          <SiteInternalLinks />
        </div>
      </article>
      <Sidebar />
    </div>
  </main>
</BaseLayout>
