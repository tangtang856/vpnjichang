---
import type { Airport } from '../data/airports';

interface Props {
  airport: Airport;
  showReviewLink?: boolean;
}

const { airport, showReviewLink = true } = Astro.props;
const p0 = airport.plans[0];
const pMax = airport.plans[airport.plans.length - 1];
---

<div class="airport-card">
  <div class="card-header">
    <h3 class="airport-brand-name"><a href={`/review/${airport.slug}.html`}>{airport.name}</a></h3>
    <span class="airport-badge badge-stable">{airport.testStatus === 'tested' ? '已核验' : '官方资料'}</span>
  </div>
  <div class="card-tagline">{airport.tagline}</div>
  {airport.coupon ? (
    <div style="margin: 4px 0 8px; display: flex; align-items: center; gap: 6px;">
      <span style="font-size: 0.72rem; background: #ffe4e6; color: #e11d48; padding: 1px 6px; border-radius: 4px; font-weight: 700;">券</span>
      <span style="font-size: 0.8rem; color: #be123c; font-weight: 600;">专属优惠码: <code style="font-weight: 800; color: #e11d48; background: #fff1f2; padding: 1px 5px; border-radius: 3px;">{airport.coupon}</code></span>
    </div>
  ) : (
    <div style="margin: 4px 0 8px; display: flex; align-items: center; gap: 6px;">
      <span style="font-size: 0.72rem; background: #dcfce7; color: #15803d; padding: 1px 6px; border-radius: 4px; font-weight: 700;">特惠</span>
      <span style="font-size: 0.8rem; color: #166534; font-weight: 600;">官方直供底价 · 专属通道免码直享</span>
    </div>
  )}
  <p class="card-desc">{airport.description}</p>
  <div class="card-specs">
    <div class="spec-item"><span class="spec-label">入门起步</span><span class="spec-value">￥{airport.startingPrice.toFixed(2)}/月</span></div>
    <div class="spec-item"><span class="spec-label">月度配额</span><span class="spec-value">{p0.trafficGB} - {pMax.trafficGB} GB</span></div>
    <div class="spec-item"><span class="spec-label">协议类型</span><span class="spec-value">{airport.protocols.slice(0, 2).join(', ')}</span></div>
    <div class="spec-item"><span class="spec-label">专线类型</span><span class="spec-value">{airport.tags.includes('premium') ? 'IPLC专线' : 'BGP中转'}</span></div>
  </div>
  <div class="card-footer">
    {showReviewLink && <a href={`/review/${airport.slug}.html`} class="btn-card-review">评测报告</a>}
    <a href={`/airport/${airport.slug}.html`} class="btn-card-review" style="background:#f1f5f9; color:#475569;">资费参数</a>
    <a href={airport.affiliateUrl || airport.officialUrl} target="_blank" rel="noopener nofollow sponsored" class="btn-card-buy">前往官网</a>
  </div>
</div>
