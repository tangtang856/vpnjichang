      <div class="contact-channels-grid">
        <!-- Telegram 官方直达卡片 -->
        <div class="contact-channel-card">
          <div class="contact-channel-top">
            <div class="contact-channel-meta">
              <div class="contact-channel-icon icon-tg">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
                </svg>
              </div>
              <div>
                <div class="contact-channel-name">Telegram 官方在线联络</div>
                <div style="font-size: 0.78rem; color: #64748b;">即时在线响应 · 商务推荐首选</div>
              </div>
            </div>
            <span class="contact-channel-badge badge-tg">推荐首选</span>
          </div>
          <div class="contact-channel-value">
            <span>@xintangtang</span>
            <span style="font-size: 0.75rem; color: #64748b; font-weight: normal;">TG 用户名</span>
          </div>
          <div class="contact-actions-row">
            <a href="https://t.me/xintangtang" target="_blank" rel="noopener nofollow" class="btn-contact-action btn-action-primary-tg">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
              </svg>
              <span>立即打开 Telegram</span>
            </a>
            <button class="btn-contact-action btn-action-copy" type="button" data-copy="@xintangtang">
              <span>📋 复制用户名</span>
            </button>
          </div>
        </div>

        <!-- Gmail 官方邮箱卡片 -->
        <div class="contact-channel-card">
          <div class="contact-channel-top">
            <div class="contact-channel-meta">
              <div class="contact-channel-icon icon-gmail">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                </svg>
              </div>
              <div>
                <div class="contact-channel-name">Gmail 官方商务与工单邮箱</div>
                <div style="font-size: 0.78rem; color: #64748b;">工单与商务跟进 · 24小时内必复</div>
              </div>
            </div>
            <span class="contact-channel-badge badge-gmail">官方邮箱</span>
          </div>
          <div class="contact-channel-value">
            <span>xintangtang888@gmail.com</span>
            <span style="font-size: 0.75rem; color: #64748b; font-weight: normal;">Gmail 邮箱</span>
          </div>
          <div class="contact-actions-row">
            <a href="mailto:xintangtang888@gmail.com?subject=%E5%95%86%E5%8A%A1%E5%90%88%E4%BD%9C%2F%E5%92%A8%E8%AF%A2%E5%8F%8D%E9%A6%88" class="btn-contact-action btn-action-primary-gmail">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
              <span>立即发送邮件</span>
            </a>
            <button class="btn-contact-action btn-action-copy" type="button" data-copy="xintangtang888@gmail.com">
              <span>📋 复制邮箱地址</span>
            </button>
          </div>
        </div>
      </div>

      <!-- 承接业务与服务保障说明 -->
      <div class="contact-coop-scope">
        <div class="contact-scope-title">
          <span>💼</span>
          <span>合作承接范围与服务承诺：</span>
        </div>
        <ul class="contact-scope-list">
          <li><strong>服务商送测入驻：</strong>接受稳定运营 1 年以上优质 IPLC / 中转机场实测与收录评估。</li>
          <li><strong>独家优惠码发放：</strong>协助官方品牌在独立评测档案中上架专属折扣福利。</li>
          <li><strong>数据校准与勘误：</strong>若测速节点、套餐资费或协议有更新，核实后 24 小时内修正。</li>
          <li><strong>隐私安全保障：</strong>全程严格遵守商业保密协议，绝不向任何第三方透露沟通细节。</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<!-- 复制成功轻提示 Toast -->
<div id="contact-toast" class="contact-toast" aria-live="polite">
  <span>✓</span>
  <span id="contact-toast-text">已成功复制到剪贴板！</span>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 移动端菜单切换脚本
    const toggleBtn = document.querySelector('.mobile-toggle');
    const navMenu = document.querySelector('.nav-menu');
    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', !isExpanded);
        navMenu.classList.toggle('active');
      });
    }

    // 联络弹窗交互
    const modal = document.getElementById('contact-modal');
    const openBtn = document.getElementById('btn-open-contact');
    const closeBtn = document.getElementById('btn-close-contact');
    const toast = document.getElementById('contact-toast');
    const toastText = document.getElementById('contact-toast-text');

    function openModal() {
      if (modal) {
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
      if (openBtn) openBtn.setAttribute('aria-expanded', 'true');
    }

    function closeModal() {
      if (modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }
      if (openBtn) openBtn.setAttribute('aria-expanded', 'false');
    }

    if (openBtn) openBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    // 点击蒙层关闭
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });
    }

    // ESC 键关闭
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.classList.contains('active')) {
        closeModal();
      }
    });

    // 一键复制功能
    let toastTimer = null;
    const copyButtons = document.querySelectorAll('.btn-action-copy');
    copyButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const textToCopy = btn.getAttribute('data-copy');
        if (!textToCopy) return;

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(textToCopy).then(() => {
            showToast(`已成功复制：${textToCopy}`);
          }).catch(() => {
            fallbackCopy(textToCopy);
          });
        } else {
          fallbackCopy(textToCopy);
        }
      });
    });

    function fallbackCopy(text) {
      const tempInput = document.createElement('input');
      tempInput.value = text;
      document.body.appendChild(tempInput);
      tempInput.select();
      document.execCommand('copy');
      document.body.removeChild(tempInput);
      showToast(`已成功复制：${text}`);
    }

    function showToast(msg) {
      if (!toast) return;
      if (toastText) toastText.textContent = msg;
      toast.classList.add('active');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.remove('active');
      }, 2500);
    }
  });
</script>
